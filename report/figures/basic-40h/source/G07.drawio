        </mxCell>
        <mxCell id="x-tail-note" value="Tail pair (98, pad): odd residuals are zero and consume no payload bits.&#10;Before SRAM write, reconstructed valid rows must lie in [−32768, 32767]; overflow raises fault and blocks write." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=23;fontStyle=0;fontColor=#2B4963;">
