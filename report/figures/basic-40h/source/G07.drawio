        <mxCell id="x-order-note" value="TAIL_FIRST remaps transport order to matrix coordinates; each 8-row block restarts from a zero reference." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=21;fontStyle=0;fontColor=#2B4963;">
