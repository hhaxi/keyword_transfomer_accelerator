        <mxCell id="restore-body" value="X_even = X_prev + δ_even&#10;X_odd = X_even + δ_odd&#10;Apply independently at both K positions." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=23;fontStyle=0;fontColor=#2B4963;">
