--- fmt1_ref/rtl/kwt_clock_gate.sv
+++ fmt1_cg_result/rtl/kwt_clock_gate.sv
@@ -0,0 +1,11 @@
+// Positive-edge clock gate. Enable is held constant throughout the high phase.
+// Simulation/frontend synthesis uses the latch model. DC must use a real ICG.
+module kwt_clock_gate(input wire clk,en,test_en,output wire gclk);
+`ifdef KWT_USE_LIBRARY_ICG
+ `include "kwt_icg_instance.vh"
+`else
+ reg enable_latched;
+ always_latch if(!clk) enable_latched=en | test_en;
+ assign gclk=clk & enable_latched;
+`endif
+endmodule
--- fmt1_ref/rtl/kwt_group_queue.sv
+++ fmt1_cg_result/rtl/kwt_group_queue.sv
@@ -25,9 +25,14 @@
  genvar b,j;
  generate for(b=0;b<DEPTH;b=b+1)begin:banks
    reg [39:0] values[0:31];
+   wire [3:0] payload_clk;
+   for(genvar cg=0;cg<4;cg=cg+1)begin:clock_groups
+     kwt_clock_gate u_gate(.clk(clk),.en(publish && write_bank==b),
+       .test_en(1'b0),.gclk(payload_clk[cg]));
+   end
    for(j=0;j<32;j=j+1)begin:lanes
      // Data need not reset: groups is cleared before any read is valid.
-     always @(posedge clk)
+     always @(posedge payload_clk[j/8])
        if(publish && write_bank==b) values[j]<=in_values[j*40+:40];
    end
    assign bank_output[b]=values[lane];
